# Copy to .env for local development:  cp .env.example .env
# In production these are set by the ECS task definition (see deploy/), not a file.

# --- Local development -------------------------------------------------------
PORT=8765
# Embedded Postgres stored on disk (leave empty for a throwaway in-memory DB).
PGLITE_DIR=.data/dev-db
# Sign in as anyone without Google. Ignored when NODE_ENV=production.
DEV_LOGIN=1

# --- Production ---------------------------------------------------------------
# NODE_ENV=production
# PUBLIC_URL=https://mission.arcsite.com        # exact URL people open; used for the Google redirect
# DATABASE_URL=postgres://user:pass@host:5432/mission_control
#   (or the standard PGHOST / PGUSER / PGPASSWORD / PGDATABASE variables)
# DB_SSL=rds                                     # verify Amazon RDS TLS certificates

# Google Workspace sign-in (Google Cloud Console → APIs & Services → Credentials → OAuth client ID, type "Web application")
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ALLOWED_DOMAINS=arcsite.com                    # comma-separated Workspace domains allowed to sign in
# ADMIN_EMAILS=junyu@arcsite.com                 # comma-separated; these people get admin on sign-in

# Optional: "Import from Jira" when adding a project (Jira Cloud API token of a service account)
# JIRA_BASE_URL=https://arcsite.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_START_DATE_FIELD=customfield_10015        # your site's "Start date" field id, if you use one
